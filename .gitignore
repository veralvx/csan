/target
# nix build
/result
**/target/
.drafts/
.vscode
**/.ropeproject
ideas.*
todo.md
vendor/
# Typst compile outputs from the plugin test/example documents
crates/csan-typst/pkg/**/*.pdf
# The Typst package's bundle (`just typst bundle`), and tytanic's test output
crates/csan-typst/pkg/dist/
crates/csan-typst/pkg/tests/**/out/
crates/csan-typst/pkg/tests/**/diff/
# Generated npm packages from wasm-pack
crates/csan-web/pkg/
crates/csan-web/pkg-node/
crates/csan-web/pkg-web/
# Python bytecode (pytest runs)
__pycache__/
*.py[cod]
# The Ruby gem's build outputs (rake compile, rake native gem, rake source_gem)
crates/csan-rb/tmp/
crates/csan-rb/pkg/
crates/csan-rb/lib/csan/*.so
crates/csan-rb/lib/csan/*.bundle
crates/csan-rb/lib/csan/*.dll
crates/csan-rb/lib/csan/[0-9]*/
