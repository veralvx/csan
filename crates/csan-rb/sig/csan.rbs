# Type signatures for the csan gem.
module Csan
  VERSION: String

  type sanborn_parts = {
    alpha_prefix: String,
    numeric: Integer,
    alpha_suffix: String?,
    entry: String,
    formatted: String
  }

  type loc_parts = { alpha_prefix: String, numeric: Integer, formatted: String }

  def self.cutter_sanborn: (
    ?forename: String?,
    ?surname: String?,
    ?title: String?,
    ?prefix_len: Integer?,
    ?suffix_len: Integer?
  ) -> String

  def self.cutter_sanborn_detailed: (
    ?forename: String?,
    ?surname: String?,
    ?title: String?,
    ?prefix_len: Integer?,
    ?suffix_len: Integer?
  ) -> sanborn_parts

  def self.cutter_loc: (
    ?forename: String?,
    ?surname: String?,
    ?title: String?,
    ?max_len: Integer?
  ) -> String

  def self.cutter_loc_detailed: (
    ?forename: String?,
    ?surname: String?,
    ?title: String?,
    ?max_len: Integer?
  ) -> loc_parts

  def self.run_cli: (Array[String] args) -> Integer

  # The extension: positional arguments, in the order of the keywords above.
  module Native
    VERSION: String

    def self.cutter_sanborn: (String?, String?, String?, Integer?, Integer?) -> String
    def self.cutter_sanborn_detailed: (String?, String?, String?, Integer?, Integer?) -> sanborn_parts
    def self.cutter_loc: (String?, String?, String?, Integer?) -> String
    def self.cutter_loc_detailed: (String?, String?, String?, Integer?) -> loc_parts
    def self.run_cli: (Array[String]) -> Integer
  end
end
